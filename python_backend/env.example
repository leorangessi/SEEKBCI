# 数据库配置
DATABASE_URL=postgresql://ssvep_user:ssvep_password@localhost:5432/ssvep_platform
REDIS_URL=redis://localhost:6379/0

# JWT配置
SECRET_KEY=your-secret-key-change-in-production-please-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO配置（可选）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ssvep-projects

# 应用配置
APP_NAME=SSVEP Platform
APP_VERSION=0.1.0
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# 文件上传配置
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
